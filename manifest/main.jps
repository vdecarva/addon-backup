jversion: 0.10
type: update
name: Backup / Restoration
baseUrl: https://raw.githubusercontent.com/vdecarva/addon-backup/master/
description:
  text:
    <br>You can easily choose a **backup** **frequency** for your containers and easily choose the **lifetime** of your backups.</br>
    For your **restoration** select the backup of your choice and restore it **everywhere** in your environment.
  short: Easily back up and restore your containers' filesystems in the container of your choice.

logo: SwissBackup.svg
globals:
  pass: ${fn.md5([user.uid])}
  env: ${env.name}
onBeforeInit: scripts/settings.js

targetNodes:
  nodeGroup: '*'

onInstall:
  - setGlobals:
      nodeGroup: ${targetNodes.nodeGroup}
  - if ('${settings.choice}' == 'full' && '${settings.mode}' == 'backup'): snapshot
  - if ('${settings.choice}' == 'folder' && '${settings.mode}' == 'backup'): backup
  - if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'classic'): restauration
  - if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'permissions'): user-restauration

actions:
  backup:
    - install:
        jps: manifest/folders.jps
        envName: ${env.name}
        nodeGroup: ${globals.nodeGroup}
        settings:
          User: "${settings.User}"
          path: "${settings.path}"
          node: "${globals.nodeGroup}"
          key: "${settings.key}"
          sauvegarde: "${settings.sauvegarde}"
          year: "${settings.year}"
          month: "${settings.month}"
          day: "${settings.day}"
    - setGlobals:
        SUCCESS: backup

  restauration:
    - install:
        jps: manifest/recovery.jps
        envName: ${env.name}
        nodeGroup: ${globals.nodeGroup}
        settings:
          id: "${settings.snapshot}"
          User: "${settings.User}"
          key: "${settings.key}"
          destination: "${settings.destination}"
          node: "${globals.nodeGroup}"
    - setGlobals:
        SUCCESS: success

  user-restauration:
    - install:
        jps: manifest/user-recovery.jps
        envName: ${env.name}
        nodeGroup: ${globals.nodeGroup}
        settings:
          id: "${settings.snapshot}"
          User: "${settings.User}"
          key: "${settings.key}"
          destination: "${settings.destination}"
          node: "${globals.nodeGroup}"
          custom: "${settings.custom}"
    - setGlobals:
        SUCCESS: success

  snapshot:
    - install:
        jps: manifest/snapshot.jps
        envName: ${env.name}
        nodeGroup: ${globals.nodeGroup}
        settings:
          User: "${settings.User}"
          node: "${globals.nodeGroup}"
          key: "${settings.key}"
          sauvegarde: "${settings.sauvegarde}"
          year: "${settings.year}"
          month: "${settings.month}"
          day: "${settings.day}"
    - setGlobals:
        SUCCESS: snapshots

  desinstall:
    - install:
        jps: manifest/uninstall.jps
        envName: ${env.name}
        nodeGroup: ${globals.nodeGroup}
        settings:
          node: "${globals.nodeGroup}"
    - setGlobals:
        SUCCESS: remove

  manage:
    - if ('${settings.choice}' == 'full' && '${settings.mode}' == 'backup'): snapshot
    - if ('${settings.choice}' == 'folder' && '${settings.mode}' == 'backup'): backup
    - if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'classic'): restauration
    - if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'permissions'): user-restauration
    - if ('${settings.mode}' == 'modify' && '${settings.choice}' == 'full'): snapshot
    - if ('${settings.mode}' == 'modify' && '${settings.choice}' == 'folder'): backup

buttons:
  - action: manage
    caption: Backup & Restore manager
    submitButtonText: Apply
    loadingText: Applying...
    settings: scripts/settings.js
  - action: desinstall
    caption: Remove backup routine
    submitButtonText: Remove backup routine
    loadingText: Remove backup routine...

success:
  text: success/${globals.SUCCESS}.md
  mail: success/${globals.SUCCESS}.md
