jversion: 0.10
type: update
name: Backup / Restoration
baseUrl: https://raw.githubusercontent.com/vdecarva/addon-backup/master/
description:
  text:
    <br>You can easily choose a **backup** **frequency** for your containers and easily choose the **lifetime** of your backups.</br>
    For your **restoration** select the backup of your choice and restore it **everywhere** in your environment.
  short: Easily back up and restore your containers' filesystems in the container of your choice.

logo: SwissBackup.svg
globals:
  pass: ${fn.md5([user.uid])}
  env: ${env.name}
onBeforeInit: scripts/settings.js

targetNodes:
  nodeGroup: '*'

onInstall:
  if ('${settings.choice}' == 'full' && '${settings.mode}' == 'backup' ):
    - snapshot
  if ('${settings.choice}' == 'folder' && '${settings.mode}' == 'backup'):
    - backup
  if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'classic'):
    - restauration
  if ('${settings.mode}' == 'restauration' && '${settings.permissions}' == 'permissions'):
    - user-restauration

actions:
  backup:
    install:
      jps: manifest/folders.jps
    setGlobals:
      SUCCESS: backup
    settings:
      User: "${settings.User}"
      path: "${settings.path}"
      node: "${targetNodes.nodeGroup}"
      key: "${settings.key}"
      sauvegarde: "${settings.sauvegarde}"
      year: "${settings.year}"
      month: "${settings.month}"
      day: "${settings.day}"

  restauration:
    install:
      jps: manifest/recovery.jps
    setGlobals:
      SUCCESS: success
    settings:
      id: "${settings.snapshot}"
      User: "${settings.User}"
      key: "${settings.key}"
      destination: "${settings.destination}"
      node: "${targetNodes.nodeGroup}"

  user-restauration:
    install:
      jps: manifest/user-recovery.jps
    setGlobals:
      SUCCESS: success
    settings:
      id: "${settings.snapshot}"
      User: "${settings.User}"
      key: "${settings.key}"
      destination: "${settings.destination}"
      node: "${targetNodes.nodeGroup}"
      custom: "${settings.custom}"

  snapshot:
    install:
      jps: manifest/snapshot.jps
    setGlobals:
      SUCCESS: snapshots
    settings:
      User: "${settings.User}"
      node: "${targetNodes.nodeGroup}"
      key: "${settings.key}"
      sauvegarde: "${settings.sauvegarde}"
      year: "${settings.year}"
      month: "${settings.month}"
      day: "${settings.day}"

  desinstall:
    install:
      jps: manifest/uninstall.jps
    setGlobals:
      SUCCESS: remove
    settings:
      node: "${targetNodes.nodeGroup}"

  modify:
    - if ('${settings.sauvegarde}' == 'hourly' && '${settings.choice}' == 'full'): modify-hourly-full
    - if ('${settings.sauvegarde}' == 'hourly' && '${settings.choice}' == 'folder'): modify-hourly-folder
    - if ('${settings.sauvegarde}' == 'daily' && '${settings.choice}' == 'full'): modify-daily-full
    - if ('${settings.sauvegarde}' == 'daily' && '${settings.choice}' == 'folder'): modify-daily-folder

  modify-hourly-full:
    cmd[${targetNodes.nodeGroup}]: |-
      curl -fsSL https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/retention-all.sh --output /root/retention-all.sh
      chmod u+x /root/retention-all.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/purge.sh --output /root/purge.sh
      chmod u+x /root/purge.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/heal.sh --output /root/heal.sh
      chmod u+x /root/heal.sh
      if [ -f "/var/spool/cron/crontabs/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/crontabs/root; elif [ -f "/var/spool/cron/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/root; else echo "first install"; fi
      crontab -u root -l | grep -v '/root/heal.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "50 1 * * WED /root/heal.sh "; } | crontab -
      crontab -u root -l | grep -v '/root/retention-all.sh'  | crontab -u root -
      crontab -u root -l | grep -v '/root/retention-repo.sh' | crontab -u root -
      crontab -u root -l | { cat; echo "0 */1 * * * /usr/bin/nohup /usr/bin/flock --nonblock --conflict-exit-code 0 /run/user/restic.lock /root/retention-all.sh >> /var/log/restic.log 2>&1 "; } | crontab -
      crontab -u root -l | grep -v '/root/purge.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "30 22 * * * perl -le 'sleep rand 600' && /root/purge.sh -y \"${settings.year}\" -m \"${settings.month}\" -d \"${settings.day}\" >> /var/log/retention.log 2>&1 "; } | crontab -
      touch /var/log/restic.log /var/log/retention.log /root/retention.log
    user: root

  modify-hourly-folder:
    cmd[${targetNodes.nodeGroup}]: |-
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/retention-repo.sh --output /root/retention-repo.sh
      chmod u+x /root/retention-repo.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/purge.sh --output /root/purge.sh
      chmod u+x /root/purge.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/heal.sh --output /root/heal.sh
      chmod u+x /root/heal.sh
      if [ -f "/var/spool/cron/crontabs/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/crontabs/root; elif [ -f "/var/spool/cron/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/root; else echo "first install"; fi
      crontab -u root -l | grep -v '/root/heal.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "50 1 * * WED /root/heal.sh "; } | crontab -
      crontab -u root -l | grep -v '/root/retention-all.sh'  | crontab -u root -
      crontab -u root -l | grep -v '/root/retention-repo.sh' | crontab -u root -
      crontab -u root -l | { cat; echo "0 */1 * * * /usr/bin/nohup /usr/bin/flock --nonblock --conflict-exit-code 0 /run/user/restic.lock /root/retention-repo.sh -f \"${settings.path}\" >> /var/log/restic.log 2>&1 "; } | crontab -
      crontab -u root -l | grep -v '/root/purge.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "30 22 * * * perl -le 'sleep rand 600' && /root/purge.sh -y \"${settings.year}\" -m \"${settings.month}\" -d \"${settings.day}\" >> /var/log/retention.log 2>&1 "; } | crontab -
      touch /var/log/restic.log /var/log/retention.log /root/retention.log
    user: root

  modify-daily-full:
    cmd[${targetNodes.nodeGroup}]: |-
      curl -fsSL https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/retention-all.sh --output /root/retention-all.sh
      chmod u+x /root/retention-all.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/purge.sh --output /root/purge.sh
      chmod u+x /root/purge.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/heal.sh --output /root/heal.sh
      chmod u+x /root/heal.sh
      if [ -f "/var/spool/cron/crontabs/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/crontabs/root; elif [ -f "/var/spool/cron/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/root; else echo "first install"; fi
      crontab -u root -l | grep -v '/root/heal.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "50 1 * * WED /root/heal.sh "; } | crontab -
      crontab -u root -l | grep -v '/root/retention-all.sh'  | crontab -u root -
      crontab -u root -l | grep -v '/root/retention-repo.sh' | crontab -u root -
      crontab -u root -l | { cat; echo "0 20 * * * /usr/bin/nohup /usr/bin/flock --nonblock --conflict-exit-code 0 /run/user/restic.lock /root/retention-all.sh >> /var/log/restic.log 2>&1 "; } | crontab -
      crontab -u root -l | grep -v '/root/purge.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "30 22 * * * perl -le 'sleep rand 600' && /root/purge.sh -y \"${settings.year}\" -m \"${settings.month}\" -d \"${settings.day}\" >> /var/log/retention.log 2>&1 "; } | crontab -
      touch /var/log/restic.log /var/log/retention.log /root/retention.log
    user: root

  modify-daily-folder:
    cmd[${targetNodes.nodeGroup}]: |-
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/retention-repo.sh --output /root/retention-repo.sh
      chmod u+x /root/retention-repo.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/purge.sh --output /root/purge.sh
      chmod u+x /root/purge.sh
      curl -fsS https://raw.githubusercontent.com/Infomaniak/addon-backup/master/scripts/heal.sh --output /root/heal.sh
      chmod u+x /root/heal.sh
      if [ -f "/var/spool/cron/crontabs/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/crontabs/root; elif [ -f "/var/spool/cron/root" ]; then sed -i '/restic.lock/d' /var/spool/cron/root; else echo "first install"; fi
      crontab -u root -l | grep -v '/root/heal.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "50 1 * * WED /root/heal.sh "; } | crontab -
      crontab -u root -l | grep -v '/root/retention-all.sh'  | crontab -u root -
      crontab -u root -l | grep -v '/root/retention-repo.sh' | crontab -u root -
      crontab -u root -l | { cat; echo "0 20 * * * /usr/bin/nohup /usr/bin/flock --nonblock --conflict-exit-code 0 /run/user/restic.lock /root/retention-repo.sh -f \"${settings.path}\" >> /var/log/restic.log 2>&1 "; } | crontab -
      crontab -u root -l | grep -v '/root/purge.sh'  | crontab -u root -
      crontab -u root -l | { cat; echo "30 22 * * * perl -le 'sleep rand 600' && /root/purge.sh -y \"${settings.year}\" -m \"${settings.month}\" -d \"${settings.day}\" >> /var/log/retention.log 2>&1 "; } | crontab -
      touch /var/log/restic.log /var/log/retention.log /root/retention.log
    user: root

  user: root

buttons:
  - action: modify
    caption: Modify backup routine
    submitButtonText: Apply
    loadingText: Updating backup routine...
    settings: scripts/modify-settings.js
  - action: desinstall
    caption: Remove backup routine
    submitButtonText: Remove backup routine
    loadingText: Remove backup routine...

success:
  text: success/${globals.SUCCESS}.md
  mail: success/${globals.SUCCESS}.md
